// Windows のバージョン情報(エクスプローラーのプロパティに出る)
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@MPS_VENDOR@"
            VALUE "FileDescription", "MPS Synth / MPS FX (VST3)"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "MPS"
            VALUE "LegalCopyright", "Copyright (c) 2026 @MPS_VENDOR@"
            VALUE "OriginalFilename", "MPS.vst3"
            VALUE "ProductName", "MPS Synth / MPS FX"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
